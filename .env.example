# Copy to .env.local and fill in. .env.local is gitignored; never commit real keys.
# Everything about which AI models/providers are used is configured here, not in code.
# Check your setup any time with:  npm run check:models   (add -- --probe to send real test requests)

# ---- Providers -------------------------------------------------------------
# Order matters: the first is tried first, the rest are fallbacks (on rate limits, outages, bad keys...).
# A provider without an API key is skipped. Default: groq,gemini
AI_PROVIDERS=groq,gemini

# ---- Groq (fast; free tier: ~8k tokens/min per model) ---------------------
GROQ_API_KEY=
# Optional. Comma-separated, tried in order; replaces the built-in defaults when set.
# Groq retires models often: when `npm run check:models` shows MISSING, change these.
# GROQ_TEXT_MODELS=openai/gpt-oss-120b,openai/gpt-oss-20b
# GROQ_VISION_MODELS=qwen/qwen3.8-27b

# ---- Gemini (fallback) ------------------------------------------------------
GEMINI_API_KEY=
# GEMINI_MODELS=gemini-flash-latest,gemini-flash-lite-latest

# ---- Any other OpenAI-compatible provider, no code needed ---------------------
# Built-in presets (base URL known): cerebras, openrouter, together, mistral, openai.
# Add its name to AI_PROVIDERS, then set (NAME upper-cased):
# AI_PROVIDERS=groq,cerebras,gemini
# CEREBRAS_API_KEY=
# CEREBRAS_TEXT_MODELS=model-a,model-b
# CEREBRAS_VISION_MODELS=          # leave empty if it has no image models: scans will skip it
# For a host without a preset, also set <NAME>_BASE_URL (e.g. MYHOST_BASE_URL=https://example.com/v1).

# ---- Rate limiting for /api/ai and /api/detect-ingredients ---------------------
# Stops strangers from spending your provider quota. Sliding 60s window, in memory (per server
# instance: exact locally/self-hosted, best-effort on serverless). Set a value to 0 to disable it.
# AI_RATE_LIMIT_PER_MIN=20            per IP, general AI calls (recipes, assistant chat)
# AI_SCAN_RATE_LIMIT_PER_MIN=6        per IP, ingredient scans (image requests are token-heavy)
# AI_RATE_LIMIT_GLOBAL_PER_MIN=120    all IPs combined, per route

# ---- Dish photos (optional) -----------------------------------------------------
# Free access key (create an app) from https://unsplash.com/developers . Without it recipes simply keep their placeholder picture.
# Photos are only used when their description names the dish; the modal credits the photographer.
# UNSPLASH_ACCESS_KEY=
# PHOTO_RATE_LIMIT_PER_MIN=30         per IP
